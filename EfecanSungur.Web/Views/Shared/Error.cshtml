@model ErrorViewModel
@{
    // BİLEREK layout KULLANILMIYOR.
    // _Layout, IContentService.Get() çağırır. Hata tam olarak içerik yüklemeden
    // kaynaklanıyorsa, layout'lu bir hata sayfası da çöker; ASP.NET Core gövdesiz
    // 500 döner ve IIS bunu kendi genel "Server Error" sayfasıyla değiştirir —
    // yani gerçek hata görünmez olur. Bu sayfanın hiçbir bağımlılığı yok:
    // ne CSS dosyası, ne partial, ne servis.
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@Model.Title · Efecan Sungur</title>
    @* Statik dosya — servis/partial değil; sayfa yine bağımlılıksız. *@
    <link rel="icon" href="/img/logo/favicon.svg" type="image/svg+xml" />
    <style>
        /* Bağımsız sayfa: dış CSS, yazı tipi ya da servis yok. Renkler sitenin
           "Ink & Paper / Signal" paletiyle aynı, burada yerel belirteç olarak. */
        :root {
            --night: #0B0D11; --night-line: #262B35;
            --on-night: #EBE8E1; --on-night-muted: #A09F9C;
            --signal-soft: #8EA6FF; --night-grid: #15181F;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh;
            display: grid; place-items: center; padding: 48px 24px;
            background-color: var(--night); color: var(--on-night);
            background-image:
                linear-gradient(to right, var(--night-grid) 1px, transparent 1px),
                linear-gradient(to bottom, var(--night-grid) 1px, transparent 1px);
            background-size: 96px 96px;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
        }
        .box { width: 100%; max-width: 640px; }
        .mono, .rid, .eyebrow { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; }
        .mono {
            display: inline-block; padding-bottom: 6px; margin-bottom: 40px;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            font-size: 24px; font-weight: 700; letter-spacing: -.04em;
            border-bottom: 1.5px solid var(--signal-soft);
        }
        .mono span { color: transparent; -webkit-text-stroke: 1px var(--on-night); }
        .eyebrow {
            font-size: 12px; letter-spacing: .14em; text-transform: uppercase;
            color: var(--signal-soft);
        }
        .code {
            margin: 8px 0 0;
            font-size: clamp(5.5rem, 18vw, 10rem); font-weight: 700;
            line-height: .9; letter-spacing: -.06em;
        }
        h1 {
            margin: 28px 0 14px;
            font-size: clamp(1.75rem, 4.4vw, 2.5rem); font-weight: 600;
            line-height: 1.08; letter-spacing: -.03em;
        }
        p { margin: 0 0 36px; color: var(--on-night-muted); font-size: 1.0625rem; max-width: 52ch; }
        .btns { display: flex; gap: 12px; flex-wrap: wrap; }
        a {
            display: inline-flex; align-items: center; min-height: 50px; padding: 0 24px;
            border-radius: 3px; border: 1px solid var(--on-night);
            font-size: 15px; font-weight: 500; text-decoration: none;
            transition: background-color .2s, color .2s, border-color .2s;
        }
        .primary { background: var(--on-night); color: var(--night); }
        .primary:hover { background: var(--signal-soft); border-color: var(--signal-soft); }
        .ghost { color: var(--on-night); border-color: var(--night-line); }
        .ghost:hover { border-color: var(--on-night-muted); }
        a:focus-visible { outline: 2px solid var(--signal-soft); outline-offset: 3px; }
        .rid { margin: 40px 0 0; font-size: 12px; color: var(--on-night-muted); }
        code { font-family: inherit; }
        @@media (prefers-reduced-motion: reduce) { a { transition: none; } }
    </style>
</head>
<body>
    <main class="box">
        <div class="mono" aria-hidden="true">E<span>S</span></div>
        <div class="eyebrow">Hata kodu</div>
        <div class="code">@Model.Code</div>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        <div class="btns">
            <a class="primary" href="/">Ana sayfaya dön</a>
            <a class="ghost" href="/iletisim">İletişim</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="rid">İstek kimliği: <code>@Model.RequestId</code></p>
        }
    </main>
</body>
</html>
