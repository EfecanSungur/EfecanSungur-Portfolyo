<?xml version="1.0" encoding="utf-8"?>
<!--
  Plesk 2019 / IIS barındırma ayarları.

  Bu dosya, aynı sunucuda SORUNSUZ ÇALIŞAN salurian.com yapılandırmasıyla
  birebir hizalanmıştır. Kritik üç madde:

    hostingModel="outofprocess"
      → Uygulama IIS sürecinin İÇİNDE değil, ayrı bir dotnet süreci olarak
        çalışır. In-process modda uygulama havuzunun bit genişliği (32/64)
        uyuşmazsa "500.30" alınır; out-of-process bu riski tamamen kaldırır.

    httpErrors existingResponse="PassThrough"
      → BU SATIR OLMAZSA: uygulama kendi hata sayfasını döndürse bile IIS onu
        atıp yerine kendi genel "Server Error 500" sayfasını koyar. Yani gerçek
        hatayı hiç göremezsiniz. İlk kurulumda teşhisi imkânsızlaştıran madde budur.

    stdoutLogEnabled="true"
      → İlk kurulumda sorun çıkarsa sebebini logs\ klasörüne yazar.
        Site sorunsuz çalışmaya başladıktan sonra "false" yapın.

  NOT: requestFiltering içinde SADECE requestLimits var. Gizli klasör ve
  uzantı filtresi düğümleri Plesk'te sunucu seviyesinde kilitli olabilir ve
  500.19 yapılandırma hatası verir. App_Data zaten IIS'in varsayılan
  gizli klasör listesinde olduğu için ayrıca korumaya gerek yoktur.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\EfecanSungur.Web.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!-- Panelden görsel yükleme: 20 MB -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="20971520" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

      <!-- Windows Server 2019'da .webp / .avif kayıtlı değildir; panelden bu
           formatta görsel yüklenirse 404 verir. -->
      <staticContent>
        <remove fileExtension=".webmanifest" />
        <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".avif" />
        <mimeMap fileExtension=".avif" mimeType="image/avif" />
        <remove fileExtension=".svg" />
        <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      </staticContent>

      <urlCompression doStaticCompression="true" doDynamicCompression="true" />

      <!-- Uygulamanın kendi hata sayfası IIS tarafından ezilmesin -->
      <httpErrors existingResponse="PassThrough" />

      <!--
        URL Rewrite bölümü BİLEREK yok: modül kurulu değilse IIS 500.19 verir.
        http->https ve www->apex yönlendirmesi uygulamada yapılır
        (appsettings.json -> Site:CanonicalRedirect, SSL çalışınca true).
      -->

    </system.webServer>
  </location>
</configuration>
